{
  "$schema": "authoring-kit/spec@1",
  "schema_version": 1,
  "id": "algo-guide",
  "label": "알고리즘 가이드",
  "version": "1.0.0",
  "source": {
    "origin": "reverse-extraction",
    "refs": [
      "code_test ORD-003 — .claude/skills/guide-for-problem/algorithm-guide-canvas.md (10단계 골격)",
      "code_test .claude/skills/guide-for-problem/assets/QUALITY_CHECKLIST.md (B·C·D·G축)"
    ],
    "note": "캔버스의 `##` 문구·순서는 고정이고, HTML 주석에 절별 '직무'가 적혀 있었다. 그 직무를 spec.md 로 옮기고 골격을 sections[] 로 옮겼다."
  },

  "voice": { "default": "ppangto-teacher", "allowed": ["ppangto-teacher"] },

  "sections": [
    { "id": "title",     "label": "제목 + 부제",          "required": true,  "order": 5,
      "heading": "# {알고리즘 이름} — {직관을 담은 부제}", "heading_fixed": false },
    { "id": "concept",   "label": "한눈에 보는 컨셉",       "required": true,  "order": 10,
      "heading": "## 한눈에 보는 컨셉", "heading_fixed": true },
    { "id": "naive",     "label": "출발점: 가장 순진한 방법부터", "required": true, "order": 20,
      "heading": "## 출발점: 가장 순진한 방법부터", "heading_fixed": true },
    { "id": "idea",      "label": "아이디어 자세히 들여다보기", "required": true, "order": 30,
      "heading": "## 아이디어 자세히 들여다보기", "heading_fixed": true, "container": true },
    { "id": "idea.formal", "label": "수식과 그림",          "required": true,  "order": 31,
      "heading": "### {아이디어를 담은 제목} — 수식과 그림", "heading_fixed": false, "parent": "idea" },
    { "id": "idea.theory", "label": "단서를 설명해 주는 이론", "required": false, "order": 32,
      "heading": "### 단서를 설명해 주는 이론 — {이론 이름}", "heading_fixed": false, "parent": "idea",
      "condition": "근거·단서를 해소하는 실마리가 이미 이론화되어 있을 때" },
    { "id": "idea.ds",   "label": "셈을 맡는 자료구조",      "required": false, "order": 33,
      "heading": "### 셈을 맡는 자료구조 — {자료구조 이름}", "heading_fixed": false, "parent": "idea",
      "condition": "문제 해결에 보조 자료구조가 필요할 때" },
    { "id": "idea.proof", "label": "왜 모순 없이 작동하는가", "required": true,  "order": 34,
      "heading": "### 왜 모순 없이 작동하는가", "heading_fixed": true, "parent": "idea" },
    { "id": "impl",      "label": "아이디어를 코드로 옮기기",  "required": true,  "order": 40,
      "heading": "## 아이디어를 코드로 옮기기", "heading_fixed": true },
    { "id": "clue",      "label": "더 빠르게 만들 단서 찾기",  "required": true,  "order": 50,
      "heading": "## 더 빠르게 만들 단서 찾기", "heading_fixed": true },
    { "id": "optimize",  "label": "단서를 최적화로 연결하기",  "required": true,  "order": 60,
      "heading": "## 단서를 최적화로 연결하기", "heading_fixed": true },
    { "id": "optcode",   "label": "최적화 코드",            "required": true,  "order": 70,
      "heading": "## 최적화 코드", "heading_fixed": true,
      "repeat": "5~7단계는 추가 최적화 여지가 있으면 묶음으로 반복한다" },
    { "id": "sim",       "label": "실행 시각화",            "required": true,  "order": 80,
      "heading": "## 실행 시각화", "heading_fixed": true },
    { "id": "flow",      "label": "흐름 한눈에 보기",        "required": true,  "order": 90,
      "heading": "## 흐름 한눈에 보기", "heading_fixed": true },
    { "id": "selfcheck", "label": "스스로 점검하기",         "required": true,  "order": 100,
      "heading": "## 스스로 점검하기", "heading_fixed": true }
  ],

  "principles": [
    { "code": "B1", "level": "MUST",   "axis": "structure",
      "text": "원천 아이디어 선행 — 풀이를 던지기 전에 원천이 되는 아이디어/알고리즘을 먼저 설명한다" },
    { "code": "B2", "level": "MUST",   "axis": "structure",
      "text": "유도 생략 없음 — 원천에서 솔루션으로 가는 과정을 단계별로 생략 없이 전개한다(원형 → 관찰 → 개선)" },
    { "code": "B3", "level": "MUST",   "axis": "evidence",
      "text": "핵심 주장마다 근거(불변식·증명 골자·복잡도 유도·반례)가 붙는다" },
    { "code": "B4", "level": "SHOULD", "axis": "scope-principle",
      "text": "트레이드오프 — 대안·한계·비용을 짚는다(가능한 다른 접근 대비 이 풀이의 위치)" },
    { "code": "B5", "level": "MUST",   "axis": "structure",
      "text": "직관 선행 — 핵심 아이디어 섹션에서 수식·코드 전에 인간 친화적 직관 1~2문장이 먼저 온다" },
    { "code": "B6", "level": "MUST",   "axis": "structure",
      "text": "코드 진화 사다리 — 원형(brute force) + 최소 1단계 개선 + 최종 구현. 자연스러운 진화 단계가 있는 알고리즘에만 적용" },

    { "code": "C1", "level": "MUST",   "axis": "structure",
      "text": "성능 목표 예측 — 입력 규모·제약에서 요구되는 목표 복잡도를 예측한다. **`naive` 절의 제약 규모 + `concept` 절의 복잡도 표기로 충족**한다" },
    { "code": "C2", "level": "MUST",   "axis": "structure",
      "text": "목표 함수 — 함수 시그니처·입출력 계약을 명시한다. **`naive` 절의 시그니처 코드 블록으로 충족**한다" },
    { "code": "C3", "level": "MUST",   "axis": "structure",
      "text": "핵심 아이디어 — B축을 만족하는 `idea` 섹션이 있다" },
    { "code": "C4", "level": "MUST",   "axis": "structure",
      "text": "최종 알고리즘의 흐름이 도식으로 정리된다. **`flow` 절의 mermaid 다이어그램으로 충족**한다(구 템플릿의 '수도 코드'는 `impl`·`optcode`의 실제 코드가 대체)" },
    { "code": "C5", "level": "SHOULD", "axis": "structure",
      "text": "마무리 — 핵심 재진술 + 복잡도 결론(목표 달성 여부). **`optcode` 절 끝의 종료 선언으로 충족**한다" },

    { "code": "D1", "level": "MUST",   "axis": "scope-principle",
      "text": "다각 조명 — 최소 한 개념을 2개 이상 관점(정의/수식 + 트레이스, 원리 + 시뮬)으로 비춘다" },
    { "code": "D2", "level": "IF-APPLICABLE", "axis": "scope-principle",
      "text": "트레이스 예시 — 작은 고정 입력에 대한 단계별 손 추적" },
    { "code": "D3", "level": "IF-APPLICABLE", "axis": "scope-principle",
      "text": "도식 — 핵심 개념 직후 그림이 있고 상태 변화 연산에 before/after 가 있다" },
    { "code": "D4", "level": "MUST",   "axis": "scope-principle",
      "text": "시뮬레이션 위탁 규약 — `실행 시각화`가 `#guide-sim` import + 선언형 `steps`만 쓴다" },
    { "code": "D5", "level": "IF-APPLICABLE", "axis": "scope-principle",
      "text": "구현/코드 — 코드가 맥락 없이 먼저 나오지 않고, 의미 단위 설명이 붙는다" },
    { "code": "D6", "level": "MUST",   "axis": "scope-principle",
      "text": "함정 포인팅 — 독자가 빠지기 쉬운 실수를 구체적 잘못 시나리오로 보인다" },

    { "code": "E5", "level": "MUST",   "axis": "evidence",
      "text": "본문 코드 자기 검증 — 가이드가 싣는 코드가 그 자체로 실행 가능하고, 본문의 주장과 일치한다" },
    { "code": "E6", "level": "MUST",   "axis": "evidence",
      "text": "복잡도 진술의 완전성 — 최종 복잡도가 **어느 비용만 센 값인지** 밝힌다. 앞뒤로 붙는 항(정렬·전처리·좌표압축)이 있으면 총식을 한 번은 정확히 쓰고, 왜 흔히 생략되는지 덧붙인다. 지배항만 적고 넘어가면 미흡" },
    { "code": "E7", "level": "MUST",   "axis": "evidence",
      "text": "복잡도 보장의 종류 — `O(1)` 이 최악 보장인지 기대값인지 구분해 밝힌다(해시 기반 자료구조·상환 분석·확률적 구조). 보장 종류를 안 밝히면 미흡" },
    { "code": "F3", "level": "IF-APPLICABLE", "axis": "scope-principle",
      "text": "의존성 범위 분석 — 공간/시간 최적화가 있으면 '왜 그 최적화가 유효한가'의 이론적 근거가 있다" },

    { "code": "G1", "level": "MUST",   "axis": "structure",
      "text": "빌드 통과 — `commands.build` 가 통과한다" },
    { "code": "G2", "level": "IF-APPLICABLE", "axis": "structure",
      "text": "시뮬 위탁 규약 — 문제별 JSX/Hook·외부 라이브러리 import 가 없다" },
    { "code": "G3", "level": "IF-APPLICABLE", "axis": "evidence",
      "text": "시뮬 정확성 — 고정 입력·마지막 프레임 결과가 본문에 명시된 실제 반환값과 일치한다" },
    { "code": "G4", "level": "IF-APPLICABLE", "axis": "structure",
      "text": "다이어그램 구문 — mermaid 블록이 `commands.mermaid_check` 를 통과한다" }
  ],

  "conditional_rule": "조건부 절은 해당 사항이 없으면 문서에서 절 자체를 생략한다. 문서 안에 '해당 없음' 메모를 남기지 않는다 — 독자용 문서에 집필 메타를 싣지 않는다. 생략 사유는 품질 게이트 보고에만 기록한다.",

  "template": {
    "kind": "canvas-md",
    "template_ref": "algo-guide-canvas",
    "slot_style": "brace-descriptive",
    "outputs": [{ "format": "mdx", "location": "dirs.content" }]
  },

  "placeholders": {
    "profile": "std-v1",
    "legacy_accept": ["brace-descriptive", "html-comment-instruction"]
  },

  "gate": {
    "rubric": "default",
    "max_rounds": 3,
    "external_review": { "enabled": true, "axes": "review-axes/guide.md",
                         "failure_policy": "hard-fail", "redact": "none" }
  }
}
