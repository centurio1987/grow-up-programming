{
  "permissions": {
    "allow": [
      "Bash(bun test*)",
      "Bash(bun*)",
      "Bash(open *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -x \"$CLAUDE_PROJECT_DIR/tools/generate-guides-index.sh\" ]; then \"$CLAUDE_PROJECT_DIR/tools/generate-guides-index.sh\" > /dev/null; fi"
          }
        ]
      }
    ]
  }
}
